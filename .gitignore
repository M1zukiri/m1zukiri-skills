# Never commit real settings — template only
settings.json

# Never commit credentials or tokens
*.token
*.key
*.pem
.env

# OS files
.DS_Store
Thumbs.db

# Python bytecode cache —— .pyc 里嵌有绝对路径，公开仓库绝不能带
__pycache__/
*.pyc

# Codex credentials / machine-specific config
auth.json
config.toml

# profiles local 区：本机环境知识，不跨机、不进 git
agents/profiles/local/
